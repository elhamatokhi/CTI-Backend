<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Upload Image</title>
    <link rel="stylesheet" href="CSS/style.css" />
  </head>
  <body>
    <div class="upload-container">
      <h1>Upload Successful!</h1>
      <img
        src="<%= imageUrl %>"
        alt="Uploaded Image"
        style="max-width: 300px"
      />
      <a href="/">Upload Another Image</a>
    </div>
  </body>
</html>
