<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Favorite - Movie</title>
    <style>
      form {
        display: flex;
        flex-direction: column;
        justify-self: center;
        gap: 1rem;
      }
    </style>
  </head>
  <body>
    <div class="form_container">
      <h1>Enter your favorite Movie and Rate it from 1 to 10!</h1>
      <form action="/submit" method="post">
        <label for="movie">Movie</label>
        <input
          type="text"
          name="movie"
          placeholder="Your favorite movie"
          required
          pattern="[A-Za-z\s]+"
          title="Movie name must contain only letters and spaces."
          required
        />
        <label for="rating">Rating: </label>
        <input
          type="number"
          placeholder="Rate from 1 to 10"
          name="rating"
          mib="1"
          max="10"
        />
        <button type="submit">Submit</button>
      </form>
    </div>

    <h1>Submitted Movies</h1>
    <ul>
      <% movies.forEach(function(movieObj) { %>
      <li>
        <strong><%= movieObj.movie %></strong> - Rating: <%= movieObj.rating %>
      </li>
      <% }); %>
    </ul>
  </body>
</html>
